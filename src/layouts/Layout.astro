---
interface Props { titel: string; actief: "overzicht" | "instellingen" | "assistent" }
const { titel, actief } = Astro.props;
const nav = [
  { href: "/", id: "overzicht", label: "Overzicht", icon: "M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" },
  { href: "/assistent", id: "assistent", label: "Assistent", icon: "M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" },
  { href: "/instellingen", id: "instellingen", label: "Rekeningen", icon: "M3 10h18M5 10V20M19 10V20M9 14v3M15 14v3M12 3l9 5H3l9-5zM3 20h18" },
];
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{titel} · iCount</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='9' fill='%230f1115'/><path d='M11 22V13M16 22V9M21 22v-6' stroke='white' stroke-width='3' stroke-linecap='round'/></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      color-scheme: light;
      --bg: #ffffff; --side: #fafafb; --panel: #ffffff; --soft: #f6f7f9; --line: #ebecf0; --line-2: #dfe1e6;
      --text: #0f1115; --text-2: #5b616e; --text-3: #8b909b;
      --accent: #0f1115; --pos: #0f8a5f; --neg: #d93636;
      --bv1: #2a78d6; --bv2: #eb6834; --bv3: #6250d6; --bv4: #1baf7a;
    }
    * { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; font: 14px/1.5 Inter, system-ui, sans-serif; background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }
    .num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum", "cv01"; letter-spacing: -0.01em; }
    .t2 { color: var(--text-2); } .t3 { color: var(--text-3); }
    .pos { color: var(--pos); } .neg { color: var(--neg); }
    a { color: inherit; }

    .app { position: relative; display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; background: linear-gradient(to right, var(--side) 232px, var(--line) 232px, var(--line) 233px, transparent 233px); }
    aside { position: sticky; top: 0; height: 100vh; padding: 22px 14px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 28px; background: var(--side); }
    .logo { display: flex; align-items: center; gap: 10px; padding: 0 8px; font-weight: 700; font-size: 16px; text-decoration: none; letter-spacing: -0.01em; }
    .logo svg { flex: none; }
    .navl { display: flex; flex-direction: column; gap: 2px; }
    .navl a { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 9px; text-decoration: none; color: var(--text-2); font-weight: 500; }
    .navl a:hover { background: #f0f1f4; color: var(--text); }
    .navl a[aria-current] { background: #fff; color: var(--text); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgba(16,24,40,.05); }
    .navl svg { width: 17px; height: 17px; }
    .status { margin-top: auto; padding: 12px; border: 1px solid var(--line); border-radius: 12px; font-size: 12px; color: var(--text-2); background: #fff; }
    .status b { display: flex; align-items: center; gap: 7px; color: var(--text); font-weight: 600; font-size: 13px; margin-bottom: 2px; }
    .status b::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--pos); box-shadow: 0 0 0 3px rgba(15,138,95,.15); }

    main { padding: 32px 40px 72px; min-width: 0; max-width: 1280px; }
    .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: 0 1px 2px rgba(16,24,40,.04); }
    .btn { box-shadow: 0 1px 2px rgba(16,24,40,.05); display: inline-flex; align-items: center; gap: 7px; font: inherit; font-weight: 500; padding: 8px 13px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--panel); color: var(--text); cursor: pointer; text-decoration: none; }
    .btn:hover { background: var(--soft); }
    .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn.primary:hover { background: #2a2d35; }
    .eyebrow { font-size: 12px; font-weight: 500; color: var(--text-2); }
    .alert { padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 12px; border: 1px solid; }
    .alert.ok { border-color: #bfe5d4; background: #f0faf5; color: var(--pos); }
    .alert.err { border-color: #f5c2c2; background: #fdf3f3; color: var(--neg); }
    .chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 999px; background: var(--soft); color: var(--text-2); border: 1px solid var(--line); }
    .chip.live { background: #f0faf5; color: var(--pos); border-color: #cdeadc; }

    @media (max-width: 900px) {
      .app { grid-template-columns: 1fr; background: none; }
      aside { position: sticky; top: 0; z-index: 20; height: auto; flex-direction: row; align-items: center; padding: 12px 16px; gap: 12px; border-right: 0; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.9); backdrop-filter: blur(12px); }
      .navl { flex-direction: row; margin-left: auto; }
      .navl a { padding: 7px 10px; }
      .navl a span { display: none; }
      .status { display: none; }
      main { padding: 20px 16px 48px; }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside>
      <a class="logo" href="/">
        <svg width="28" height="28" viewBox="0 0 32 32"><rect width="32" height="32" rx="9" fill="#0f1115"/><path d="M11 22V13M16 22V9M21 22v-6" stroke="#fff" stroke-width="3" stroke-linecap="round"/></svg>
        iCount
      </a>
      <nav class="navl">
        {nav.map((n) => (
          <a href={n.href} aria-current={actief === n.id ? "page" : undefined} title={n.label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={n.icon} /></svg>
            <span>{n.label}</span>
          </a>
        ))}
      </nav>
      <div class="status"><b>Billit</b>Cijfers worden 15 minuten bewaard. Gebruik Vernieuwen voor de laatste stand.</div>
    </aside>
    <main><slot /></main>
  </div>
</body>
</html>
