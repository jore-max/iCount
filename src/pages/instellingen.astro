---
import Layout from "../layouts/Layout.astro";
import { laad, bewaar, uitForm, bedrijvenUitBillit, metBillit, standaardNaam } from "../lib/data";
import { cfgVoor } from "../lib/billit";

if (Astro.request.method === "POST") {
  await bewaar(uitForm(await Astro.request.formData()));
  return Astro.redirect("/instellingen?ok=1", 303);
}
const opgeslagen = Astro.url.searchParams.has("ok");
const data = await laad();
const bedrijven = await bedrijvenUitBillit();
const inWinst = metBillit(data, bedrijven).bvs.map((bv) => bv.inWinst);
const billit = [1, 2, 3, 4].map((n) => !!cfgVoor(n));
const bijgewerkt = data.bijgewerkt
  ? new Date(data.bijgewerkt).toLocaleString("nl-BE", { timeZone: "Europe/Brussels", dateStyle: "medium", timeStyle: "short" })
  : "nog nooit";
---
<Layout titel="Rekeningen" actief="instellingen">
  <div class="head">
    <h1>Rekeningen</h1>
    <p class="t2">Namen, rekeningen en saldi per BV · laatst opgeslagen {bijgewerkt}</p>
  </div>
  {opgeslagen && <div class="alert ok">Opgeslagen.</div>}

  <form method="post">
    <div class="grid">
      {data.bvs.map((bv, i) => (
        <fieldset class="panel" style={`--c:var(--bv${i + 1})`}>
          <div class="kop">
            <span class="dot"></span>
            <input class="naam" name={`bv${i}_naam`} value={standaardNaam(bv.naam) ? "" : bv.naam} placeholder={bedrijven[i]?.naam || `BV ${i + 1}`} aria-label="Naam van de BV" />
            {billit[i] ? <span class="chip live">Billit</span> : <span class="chip">Handmatig</span>}
          </div>

          <div class="opties">
            <label class="check"><input type="checkbox" name={`bv${i}_inwinst`} checked={inWinst[i]} /> Telt mee in de winst</label>
            <label class="btw">Btw-nummer<input name={`bv${i}_btw`} value={bv.btw} placeholder={bedrijven[i]?.btw || "uit Billit"} /></label>
          </div>
          {billit[i]
            ? <input type="hidden" name={`bv${i}_winst`} value={bv.winstHandmatig} />
            : <label class="veld">Winst (€)<input name={`bv${i}_winst`} value={bv.winstHandmatig} inputmode="decimal" /><small>Geen Billit-PartyID ingesteld voor deze BV, dus vul je de winst zelf in.</small></label>}

          <div class="reklab"><span>Rekening</span><span>IBAN</span><span>Saldo (€)</span><span>Op datum</span><span></span></div>
          <div class="reks" data-reks={i}>
            {bv.rekeningen.map((r) => (
              <div class="rek">
                <input name={`bv${i}_rek_naam`} value={r.naam} placeholder="Zichtrekening" aria-label="Rekening" />
                <input name={`bv${i}_rek_iban`} value={r.iban} placeholder="BE00 0000 0000 0000" aria-label="IBAN" />
                <input name={`bv${i}_rek_saldo`} value={r.saldo} inputmode="decimal" aria-label="Saldo" />
                <input name={`bv${i}_rek_datum`} value={r.datum} type="date" aria-label="Op datum" />
                <button type="button" class="x" data-del aria-label="Verwijderen">×</button>
              </div>
            ))}
          </div>
          <button type="button" class="add" data-add={i}>+ Rekening toevoegen</button>
        </fieldset>
      ))}
    </div>
    <div class="bar">
      <p class="t3">Zet "Telt mee in de winst" uit voor een BV die aan de andere factureert (zoals Jove): haar winst telt dan niet mee, en haar facturen worden uit de kosten van de andere BV's gehaald. Naam en btw-nummer komen uit Billit; vul ze enkel in om ze te overschrijven. Vul per rekening het saldo op een datum in, bijvoorbeeld van je laatste uittreksel. Met een IBAN telt iCount de Billit-banktransacties na die datum erbij.</p>
      <button class="btn primary" type="submit">Opslaan</button>
    </div>
  </form>
</Layout>

<script>
  const vandaag = new Date().toISOString().slice(0, 10);
  document.addEventListener("click", (e) => {
    const t = e.target as HTMLElement;
    if (t.matches("[data-del]")) t.closest(".rek")?.remove();
    if (t.matches("[data-add]")) {
      const i = (t as HTMLElement).dataset.add;
      const row = document.createElement("div");
      row.className = "rek";
      row.innerHTML = `<input name="bv${i}_rek_naam" placeholder="Zichtrekening" /><input name="bv${i}_rek_iban" placeholder="BE00 0000 0000 0000" /><input name="bv${i}_rek_saldo" inputmode="decimal" value="0" /><input name="bv${i}_rek_datum" type="date" value="${vandaag}" /><button type="button" class="x" data-del aria-label="Verwijderen">×</button>`;
      document.querySelector(`[data-reks="${i}"]`)!.appendChild(row);
      (row.querySelector("input") as HTMLInputElement).focus();
    }
  });
</script>

<style>
  .head { margin-bottom: 20px; }
  h1 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.025em; }
  .head p { margin: 4px 0 0; font-size: 14px; }
  .grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  fieldset { margin: 0; min-width: 0; padding: 18px 22px 20px; }
  .kop { display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 3px; background: var(--c); flex: none; }
  input { width: 100%; font: inherit; font-size: 14px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 9px; background: #fff; color: var(--text); min-width: 0; box-shadow: 0 1px 2px rgba(16,24,40,.04); }
  input:focus { outline: 3px solid rgba(42,120,214,.18); border-color: #2a78d6; }
  input::placeholder { color: #b6bac3; }
  input.naam { font-size: 16px; font-weight: 600; border-color: transparent; background: transparent; box-shadow: none; padding: 4px 6px; }
  input.naam:hover { border-color: var(--line); }
  .opties { display: flex; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-top: 14px; }
  .check { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; cursor: pointer; padding-bottom: 9px; }
  .check input { width: 16px; height: 16px; box-shadow: none; accent-color: #0f1115; }
  .btw { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 500; color: var(--text-3); width: 220px; }
  .veld { display: flex; flex-direction: column; gap: 6px; margin-top: 14px; font-size: 13px; font-weight: 500; color: var(--text-3); max-width: 260px; }
  .veld small { font-weight: 400; }
  .reklab, .rek { display: grid; grid-template-columns: 1.1fr 1.6fr 1fr 1fr 32px; gap: 8px; }
  .reklab { margin-top: 16px; font-size: 12px; font-weight: 500; color: var(--text-3); }
  .rek { margin-top: 8px; align-items: center; }
  .x { width: 32px; height: 36px; border: 0; background: none; color: var(--text-3); font-size: 20px; cursor: pointer; border-radius: 8px; }
  .x:hover { background: var(--soft); color: var(--neg); }
  .add { margin-top: 10px; border: 1px dashed var(--line-2); background: none; color: var(--text-2); font: inherit; font-size: 14px; font-weight: 500; padding: 8px 12px; border-radius: 10px; cursor: pointer; }
  .bar { position: sticky; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; padding: 14px 0; background: rgba(255,255,255,.92); backdrop-filter: blur(8px); border-top: 1px solid var(--line); }
  .bar p { margin: 0; font-size: 13px; max-width: 640px; }
  @media (max-width: 720px) {
    .reklab { display: none; }
    .rek { grid-template-columns: 1fr 1fr; padding: 10px; border: 1px solid var(--line); border-radius: 12px; }
    .rek .x { grid-column: 2; justify-self: end; }
    fieldset { padding: 18px; }
    .bar { flex-direction: column; align-items: stretch; }
  }
</style>
