---
import Layout from "../layouts/Layout.astro";
import { laad, overzicht } from "../lib/data";
import { euro } from "../lib/reken";

const ditJaar = new Date().getFullYear();
const jaar = Number(Astro.url.searchParams.get("jaar")) || ditJaar;
const vernieuw = Astro.url.searchParams.has("vernieuw");

const data = await laad();
const rijen = await overzicht(data, jaar, vernieuw);
const totaalWinst = rijen.reduce((s, r) => s + r.winst, 0);
const totaalSaldo = rijen.reduce((s, r) => s + r.saldo, 0);
const totaalOmzet = rijen.reduce((s, r) => s + (r.omzet ?? 0), 0);
const aantalRek = rijen.reduce((s, r) => s + r.rekeningen.length, 0);
const jaren = [ditJaar - 2, ditJaar - 1, ditJaar];
const nu = new Date().toLocaleString("nl-BE", { timeZone: "Europe/Brussels", dateStyle: "medium", timeStyle: "short" });

// Aandeel per BV in een gestapelde balk (negatieve waarden tellen niet mee in de breedte).
const aandeel = (waarde: (r: (typeof rijen)[number]) => number) => {
  const som = rijen.reduce((s, r) => s + Math.max(0, waarde(r)), 0);
  return rijen.map((r, i) => ({ naam: r.naam, i, w: som ? (Math.max(0, waarde(r)) / som) * 100 : 0, v: waarde(r) }));
};
const balken = [
  { label: "Winst", totaal: totaalWinst, delen: aandeel((r) => r.winst) },
  { label: "Liquide middelen", totaal: totaalSaldo, delen: aandeel((r) => r.saldo) },
];
const marge = (r: (typeof rijen)[number]) => (r.omzet ? (r.winst / r.omzet) * 100 : null);
---
<Layout titel="Overzicht" actief="overzicht">
  <div class="head">
    <div>
      <h1>Overzicht {jaar}</h1>
      <p class="muted">Vier BV's samen · winst excl. btw uit Billit · {nu}</p>
    </div>
    <div class="acties">
      <div class="seg" role="tablist">
        {jaren.map((j) => <a href={`/?jaar=${j}`} aria-selected={j === jaar ? "true" : "false"}>{j}</a>)}
      </div>
      <a class="btn" href={`/?jaar=${jaar}&vernieuw=1`} title="Haal de cijfers opnieuw op uit Billit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        Vernieuwen
      </a>
    </div>
  </div>

  {rijen.filter((r) => r.fout).map((r) => <div class="alert err"><b>{r.naam}:</b> Billit gaf een fout. {r.fout}</div>)}

  <section class="kpis">
    <div class="card kpi hero">
      <span class="lbl">Winst + liquide middelen</span>
      <b class="num">{euro(totaalWinst + totaalSaldo)}</b>
      <span class="sub">over {rijen.length} BV's en {aantalRek} rekeningen</span>
    </div>
    <div class="card kpi">
      <span class="lbl">Winst {jaar}</span>
      <b class:list={["num", { neg: totaalWinst < 0 }]}>{euro(totaalWinst)}</b>
      <span class="sub muted">{totaalOmzet ? `marge ${((totaalWinst / totaalOmzet) * 100).toFixed(1).replace(".", ",")}% op ${euro(totaalOmzet)} omzet` : "geen omzet"}</span>
    </div>
    <div class="card kpi">
      <span class="lbl">Liquide middelen</span>
      <b class:list={["num", { neg: totaalSaldo < 0 }]}>{euro(totaalSaldo)}</b>
      <span class="sub muted">som van alle rekeningsaldi</span>
    </div>
  </section>

  <section class="card verdeling">
    <h2>Verdeling per BV</h2>
    {balken.map((b) => (
      <div class="balk">
        <div class="balkkop"><span>{b.label}</span><span class="num muted">{euro(b.totaal)}</span></div>
        <div class="stack">
          {b.delen.filter((d) => d.w > 0).map((d) => (
            <span style={`width:${d.w}%;background:var(--bv${d.i + 1})`} title={`${d.naam}: ${euro(d.v)}`}></span>
          ))}
        </div>
      </div>
    ))}
    <div class="legenda">
      {rijen.map((r, i) => <span><i style={`background:var(--bv${i + 1})`}></i>{r.naam}</span>)}
    </div>
  </section>

  <section class="bvs">
    {rijen.map((r, i) => (
      <article class="card bv" style={`--c:var(--bv${i + 1})`}>
        <header>
          <span class="dot"></span>
          <h3>{r.naam}</h3>
          {r.billit ? <span class="badge live">Billit</span> : <span class="badge">Handmatig</span>}
        </header>

        <div class="cijfers">
          <div>
            <span class="lbl">Winst</span>
            <b class:list={["num", { neg: r.winst < 0 }]}>{euro(r.winst)}</b>
          </div>
          <div>
            <span class="lbl">Saldo</span>
            <b class:list={["num", { neg: r.saldo < 0 }]}>{euro(r.saldo)}</b>
          </div>
        </div>

        {r.omzet !== null && (
          <div class="ok-row">
            <div class="mini"><span class="muted">Omzet</span><span class="num">{euro(r.omzet)}</span></div>
            <div class="mini"><span class="muted">Kosten</span><span class="num">{euro(r.kosten ?? 0)}</span></div>
            <div class="mini"><span class="muted">Marge</span><span class:list={["num", { neg: (marge(r) ?? 0) < 0, pos: (marge(r) ?? 0) > 0 }]}>{marge(r) === null ? "–" : `${marge(r)!.toFixed(1).replace(".", ",")}%`}</span></div>
          </div>
        )}

        <ul class="reks">
          {r.rekeningen.length === 0 && <li class="muted">Nog geen rekeningen. <a href="/instellingen">Toevoegen</a></li>}
          {r.rekeningen.map((k) => (
            <li>
              <div>
                <span class="rn">{k.naam || "Rekening"}</span>
                <span class="ri muted">{k.iban ? k.iban.replace(/(.{4})/g, "$1 ").trim() : "geen IBAN"}{k.mutatie !== null && k.mutatie !== 0 && <> · <span class:list={{ pos: k.mutatie > 0, neg: k.mutatie < 0 }}>{k.mutatie > 0 ? "+" : ""}{euro(k.mutatie)}</span> sinds {new Date(k.datum).toLocaleDateString("nl-BE", { day: "numeric", month: "short" })}</>}</span>
              </div>
              <span class:list={["num", { neg: k.huidig < 0 }]}>{euro(k.huidig)}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>
</Layout>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
  h1 { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.02em; }
  .head p { margin: 4px 0 0; font-size: 14px; }
  .acties { display: flex; gap: 8px; align-items: center; }
  .seg { display: inline-flex; padding: 3px; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; }
  .seg a { text-decoration: none; padding: 5px 12px; border-radius: 7px; font-size: 14px; font-weight: 500; color: var(--muted); }
  .seg a[aria-selected="true"] { background: var(--card); color: var(--text); box-shadow: var(--shadow); }

  .kpis { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 16px; }
  .kpi { padding: 22px 24px; display: flex; flex-direction: column; gap: 4px; }
  .kpi .lbl, .bv .lbl { font-size: 13px; font-weight: 500; color: var(--muted); }
  .kpi b { font-size: 30px; font-weight: 700; letter-spacing: -0.02em; }
  .kpi .sub { font-size: 13px; }
  .kpi.hero { background: linear-gradient(135deg, var(--accent), color-mix(in srgb, var(--accent) 60%, #0ea5e9)); border: 0; color: #fff; }
  .kpi.hero .lbl, .kpi.hero .sub { color: rgba(255,255,255,.8); }
  .kpi.hero b { font-size: 36px; }

  .verdeling { margin-top: 16px; padding: 20px 24px; }
  h2 { margin: 0 0 14px; font-size: 15px; font-weight: 600; }
  .balk + .balk { margin-top: 14px; }
  .balkkop { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 6px; font-weight: 500; }
  .stack { display: flex; height: 12px; border-radius: 999px; overflow: hidden; background: var(--soft); gap: 2px; }
  .stack span { display: block; height: 100%; }
  .legenda { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 16px; font-size: 13px; color: var(--muted); }
  .legenda i { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }

  .bvs { margin-top: 16px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .bv { padding: 20px 24px; border-top: 3px solid var(--c); min-width: 0; }
  .bv header { display: flex; align-items: center; gap: 10px; }
  .bv h3 { margin: 0; font-size: 17px; font-weight: 600; flex: 1; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--c); }
  .cijfers { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .cijfers b { display: block; font-size: 24px; font-weight: 700; letter-spacing: -0.02em; }
  .ok-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; padding: 12px 14px; background: var(--soft); border-radius: 12px; }
  .mini { display: flex; flex-direction: column; font-size: 13px; }
  .mini .num { font-weight: 600; font-size: 14px; }
  .reks { list-style: none; margin: 14px 0 0; padding: 0; }
  .reks li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-top: 1px solid var(--line); font-size: 14px; }
  .reks li > div { display: flex; flex-direction: column; min-width: 0; }
  .rn { font-weight: 500; }
  .ri { font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .reks li > .num { font-weight: 600; white-space: nowrap; }

  @media (max-width: 860px) {
    .kpis { grid-template-columns: 1fr 1fr; }
    .kpi.hero { grid-column: 1 / -1; }
    .bvs { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .kpis { grid-template-columns: 1fr; }
    h1 { font-size: 24px; }
    .kpi b { font-size: 26px; }
    .kpi.hero b { font-size: 30px; }
    .bv, .verdeling, .kpi { padding: 18px; }
    .cijfers b { font-size: 20px; }
    .ok-row { padding: 10px; }
  }
</style>
