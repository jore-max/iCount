---
import Layout from "../layouts/Layout.astro";
import { laad, overzicht } from "../lib/data";
import { euro } from "../lib/reken";

const ditJaar = new Date().getFullYear();
const jaar = Number(Astro.url.searchParams.get("jaar")) || ditJaar;
const vernieuw = Astro.url.searchParams.has("vernieuw");

const data = await laad();
const rijen = await overzicht(data, jaar, vernieuw);
// BV's die buiten de winst blijven (zoals Jove) tellen niet mee in winst, omzet, kosten en grafiek.
const inWinst = rijen.filter((r) => r.inWinst);
const buiten = rijen.filter((r) => !r.inWinst);
const totaalIntern = inWinst.reduce((s, r) => s + r.intern, 0);
const totaalWinst = inWinst.reduce((s, r) => s + r.winst, 0);
const totaalSaldo = rijen.reduce((s, r) => s + r.saldo, 0);
const totaalOmzet = inWinst.reduce((s, r) => s + (r.omzet ?? 0), 0);
const totaalKosten = inWinst.reduce((s, r) => s + (r.kosten ?? 0), 0);
const metOpen = inWinst.filter((r) => r.openstaand);
const totaalOpen = metOpen.reduce((s, r) => s + r.openstaand!.bedrag, 0);
const totaalVervallen = metOpen.reduce((s, r) => s + r.openstaand!.vervallen, 0);
const aantalOpen = metOpen.reduce((s, r) => s + r.openstaand!.aantal, 0);
const rekeningen = rijen.flatMap((r, i) => r.rekeningen.map((k) => ({ ...k, bv: r.naam, i })));
const jaren = [ditJaar - 2, ditJaar - 1, ditJaar];
const pct = (n: number) => `${n.toFixed(1).replace(".", ",")}%`;
const marge = (w: number, o: number | null) => (o ? (w / o) * 100 : null);
const iban = (s: string) => s.replace(/(.{4})/g, "$1 ").trim();
const kort = (n: number) => {
  const a = Math.abs(n);
  const s = a >= 1e6 ? `${(a / 1e6).toFixed(1).replace(".", ",").replace(",0", "")} mln` : a >= 1e3 ? `${Math.round(a / 1e3)}k` : `${Math.round(a)}`;
  return `${n < 0 ? "−" : ""}€ ${s}`;
};

// ---- Grafiek: winst per maand, gestapeld per BV ----
const MAANDEN = ["jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec"];
const reeksen = rijen.map((r, i) => ({ naam: r.naam, i, m: r.maanden, in: r.inWinst })).filter((r) => r.m && r.in);
const W = 960, H = 300, L = 64, R = 8, T = 12, B = 30;
const pw = W - L - R, ph = H - T - B;
const perMaand = MAANDEN.map((_, m) => reeksen.map((r) => ({ i: r.i, naam: r.naam, v: r.m![m].omzet - r.m![m].kosten })));
const hoog = Math.max(0, ...perMaand.map((d) => d.reduce((s, x) => s + Math.max(0, x.v), 0)));
const laag = Math.min(0, ...perMaand.map((d) => d.reduce((s, x) => s + Math.min(0, x.v), 0)));
const ruw = (hoog - laag) / 4 || 1;
const mag = 10 ** Math.floor(Math.log10(ruw));
const stap = [1, 2, 2.5, 5, 10].map((f) => f * mag).find((s) => s >= ruw)!;
const yMax = Math.ceil(hoog / stap) * stap || stap, yMin = Math.floor(laag / stap) * stap;
const y = (v: number) => T + ((yMax - v) / (yMax - yMin)) * ph;
const ticks: number[] = [];
for (let v = yMin; v <= yMax + 1e-6; v += stap) ticks.push(v);
const band = pw / 12, bw = Math.min(36, band * 0.56);
const balken = perMaand.map((d, m) => {
  const x = L + band * m + (band - bw) / 2;
  let op = 0, neer = 0;
  const seg = d.filter((s) => s.v !== 0).map((s) => {
    const van = s.v > 0 ? op : neer;
    const tot = van + s.v;
    if (s.v > 0) op = tot; else neer = tot;
    const y1 = y(Math.max(van, tot)), y2 = y(Math.min(van, tot));
    return { i: s.i, x, y: y1 + 1, h: Math.max(0, y2 - y1 - 2) };
  });
  return { m, x, seg, totaal: d.reduce((s, x) => s + x.v, 0), d };
});
const tipData = balken.map((b) => ({ maand: `${MAANDEN[b.m]} ${jaar}`, totaal: euro(b.totaal), rijen: b.d.map((s) => ({ naam: s.naam, i: s.i, v: euro(s.v) })) }));

const maxSaldo = Math.max(1, ...rijen.map((r) => Math.abs(r.saldo)));
---
<Layout titel="Overzicht" actief="overzicht">
  <div class="head">
    <div>
      <h1>Overzicht</h1>
      <p class="t2">Geconsolideerd over {rijen.length} BV's · winst exclusief btw uit Billit{buiten.length > 0 && <> · {buiten.map((r) => r.naam).join(", ")} buiten de winst</>}</p>
    </div>
    <div class="acties">
      <div class="seg">
        {jaren.map((j) => <a href={`/?jaar=${j}`} aria-current={j === jaar ? "true" : undefined}>{j}</a>)}
      </div>
      <a class="btn" href={`/?jaar=${jaar}&vernieuw=1`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
        Vernieuwen
      </a>
    </div>
  </div>

  {rijen.filter((r) => r.fout).map((r) => <div class="alert err"><b>{r.naam}</b>: Billit gaf een fout. {r.fout}</div>)}

  <section class="panel kpis">
    <div class="kpi">
      <span class="lbl">Liquide middelen + te ontvangen</span>
      <b class="num groot">{euro(totaalSaldo + totaalOpen)}</b>
      <span class="t3">op de rekeningen plus onbetaalde verkoopfacturen · stand {new Date().toLocaleDateString("nl-BE", { timeZone: "Europe/Brussels", day: "numeric", month: "long" })}</span>
    </div>
    <div class="kpi">
      <span class="lbl">Winst {jaar}</span>
      <b class:list={["num", { neg: totaalWinst < 0 }]}>{euro(totaalWinst)}</b>
      <span class="t3">{totaalOmzet ? <>marge <span class="t2">{pct((totaalWinst / totaalOmzet) * 100)}</span> op {kort(totaalOmzet)} omzet</> : "nog geen omzet"}{totaalIntern !== 0 && <> · {kort(totaalIntern)} van {buiten.map((r) => r.naam).join(", ")} weggelaten</>}</span>
    </div>
    <div class="kpi">
      <span class="lbl">Liquide middelen</span>
      <b class:list={["num", { neg: totaalSaldo < 0 }]}>{euro(totaalSaldo)}</b>
      <span class="t3">{rekeningen.length} rekeningen</span>
    </div>
    <div class="kpi">
      <span class="lbl">Nog te ontvangen</span>
      <b class="num">{metOpen.length ? euro(totaalOpen) : "–"}</b>
      <span class="t3">{metOpen.length ? <>{aantalOpen} {aantalOpen === 1 ? "factuur" : "facturen"} incl. btw{totaalVervallen > 0 && <> · <span class="neg">{kort(totaalVervallen)} vervallen</span></>}</> : "geen gegevens uit Billit"}</span>
      {metOpen.length > 0 && (
        <ul class="perbv">
          {rijen.map((r, i) => r.inWinst && r.openstaand && (
            <li title={`${r.openstaand.aantal} ${r.openstaand.aantal === 1 ? "factuur" : "facturen"}, ${euro(r.openstaand.vervallen)} vervallen`}>
              <span class="bvn"><i style={`background:var(--bv${i + 1})`}></i>{r.naam}</span>
              <span class="num">{euro(r.openstaand.bedrag)}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="panel kaart">
    <div class="kaartkop">
      <div>
        <h2>Winst per maand</h2>
        <p class="t3">Omzet min kosten per maand, gestapeld per BV</p>
      </div>
      <div class="legende">
        {reeksen.map((r) => <span><i style={`background:var(--bv${r.i + 1})`}></i>{r.naam}</span>)}
      </div>
    </div>
    {reeksen.length === 0
      ? <p class="leeg t3">Nog geen Billit-gegevens. Stel BILLIT_KEY en de PartyID's in.</p>
      : <div class="grafiek">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Winst per maand in ${jaar}, gestapeld per BV`}>
            {ticks.map((t) => (
              <g>
                <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} class:list={["grid", { nul: t === 0 }]} />
                <text x={L - 10} y={y(t) + 4} text-anchor="end" class="as">{kort(t)}</text>
              </g>
            ))}
            {balken.map((b) => (
              <g>
                {b.seg.map((s) => <rect x={s.x} y={s.y} width={bw} height={s.h} rx="3" style={`fill:var(--bv${s.i + 1})`} />)}
                <text x={b.x + bw / 2} y={H - 8} text-anchor="middle" class="as">{MAANDEN[b.m]}</text>
                <rect class="hit" data-m={b.m} x={L + band * b.m} y={T} width={band} height={ph} />
              </g>
            ))}
          </svg>
          <div class="tip" hidden></div>
          <script type="application/json" id="tipdata" set:html={JSON.stringify(tipData)} />
        </div>}
  </section>

  <div class="twee">
    <section class="panel tabel">
      <div class="kaartkop pad"><h2>Per BV</h2></div>
      <table>
        <thead><tr><th>BV</th><th class="r verberg">Omzet</th><th class="r verberg">Kosten</th><th class="r">Winst</th><th class="r">Marge</th><th class="r verberg">Te ontvangen</th></tr></thead>
        <tbody>
          {rijen.map((r, i) => (
            <tr class:list={{ buiten: !r.inWinst }}>
              <td><span class="bvn"><i style={`background:var(--bv${i + 1})`}></i>{r.naam}</span>{!r.inWinst ? <span class="chip">niet in winst</span> : !r.billit && <span class="chip">handmatig</span>}</td>
              <td class="r num t2 verberg">{r.omzet === null ? "–" : euro(r.omzet)}</td>
              <td class="r num t2 verberg">{r.kosten === null ? "–" : euro(r.kosten)}{r.intern !== 0 && <span class="sub" title={`Facturen van ${buiten.map((b) => b.naam).join(", ")} zijn niet meegeteld`}>excl. {euro(r.intern)} intern</span>}</td>
              <td class:list={["r num sterk", { neg: r.winst < 0 && r.inWinst }]}>{euro(r.winst)}</td>
              <td class="r num t2">{marge(r.winst, r.omzet) === null ? "–" : pct(marge(r.winst, r.omzet)!)}</td>
              <td class="r num t2 verberg">{r.openstaand ? <>{euro(r.openstaand.bedrag)}<span class="sub">{r.openstaand.aantal} {r.openstaand.aantal === 1 ? "factuur" : "facturen"}{r.openstaand.vervallen > 0 && <>, <span class="neg">{euro(r.openstaand.vervallen)} vervallen</span></>}</span></> : "–"}</td>
            </tr>
          ))}
        </tbody>
        <tfoot><tr><td>Totaal</td><td class="r num verberg">{euro(totaalOmzet)}</td><td class="r num verberg">{euro(totaalKosten)}</td><td class:list={["r num", { neg: totaalWinst < 0 }]}>{euro(totaalWinst)}</td><td class="r num">{totaalOmzet ? pct((totaalWinst / totaalOmzet) * 100) : "–"}</td><td class="r num verberg">{metOpen.length ? euro(totaalOpen) : "–"}</td></tr></tfoot>
      </table>
    </section>

    <section class="panel liq">
      <div class="kaartkop"><h2>Liquide middelen per BV</h2></div>
      <ul>
        {rijen.map((r, i) => (
          <li>
            <div class="liqkop"><span class="bvn"><i style={`background:var(--bv${i + 1})`}></i>{r.naam}</span><span class:list={["num sterk", { neg: r.saldo < 0 }]}>{euro(r.saldo)}</span></div>
            <div class="spoor"><span style={`width:${(Math.abs(r.saldo) / maxSaldo) * 100}%;background:var(--bv${i + 1})`}></span></div>
            <span class="t3">{totaalSaldo > 0 && r.saldo > 0 ? `${pct((r.saldo / totaalSaldo) * 100)} van totaal · ` : ""}{r.rekeningen.length} {r.rekeningen.length === 1 ? "rekening" : "rekeningen"}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="panel tabel">
    <div class="kaartkop pad">
      <h2>Rekeningen</h2>
      <a class="btn" href="/instellingen">Beheren</a>
    </div>
    <table>
      <thead><tr><th>Rekening</th><th class="verberg">IBAN</th><th class="verberg">BV</th><th class="r verberg">Sinds laatste saldo</th><th class="r">Saldo</th></tr></thead>
      <tbody>
        {rekeningen.length === 0 && <tr><td colspan="5" class="t3">Nog geen rekeningen. <a href="/instellingen">Voeg er een toe</a>.</td></tr>}
        {rekeningen.map((k) => (
          <tr>
            <td><span class="sterk">{k.naam || "Rekening"}</span><span class="mob t3"><i style={`background:var(--bv${k.i + 1})`}></i>{k.bv}</span></td>
            <td class="num t2 verberg">{k.iban ? iban(k.iban) : "–"}</td>
            <td class="verberg"><span class="bvn"><i style={`background:var(--bv${k.i + 1})`}></i>{k.bv}</span></td>
            <td class="r num verberg">{k.mutatie === null ? <span class="t3">–</span> : <span class:list={{ pos: k.mutatie > 0, neg: k.mutatie < 0, t3: k.mutatie === 0 }}>{k.mutatie > 0 ? "+" : ""}{euro(k.mutatie)}</span>}<span class="t3"> · {new Date(k.datum).toLocaleDateString("nl-BE", { day: "numeric", month: "short" })}</span></td>
            <td class:list={["r num sterk", { neg: k.huidig < 0 }]}>{euro(k.huidig)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Layout>

<script>
  const data = JSON.parse(document.getElementById("tipdata")?.textContent ?? "[]");
  const box = document.querySelector<HTMLElement>(".grafiek");
  const tip = document.querySelector<HTMLElement>(".tip");
  box?.querySelectorAll<SVGRectElement>(".hit").forEach((el) => {
    el.addEventListener("mouseenter", () => {
      const d = data[Number(el.dataset.m)];
      if (!d || !tip || !box) return;
      tip.innerHTML = `<b>${d.maand}</b>` + d.rijen.map((r: any) => `<div><span><i style="background:var(--bv${r.i + 1})"></i>${r.naam}</span><span>${r.v}</span></div>`).join("") + `<div class="tt"><span>Totaal</span><span>${d.totaal}</span></div>`;
      tip.hidden = false;
      const br = box.getBoundingClientRect(), er = el.getBoundingClientRect();
      // naast de balk, rechts als er plaats is, anders links
      const rechts = er.right - br.left + 8;
      tip.style.left = `${rechts + 220 <= br.width ? rechts : er.left - br.left - 8 - tip.offsetWidth}px`;
      box.querySelectorAll(".hit").forEach((h) => h.classList.toggle("aan", h === el));
    });
  });
  box?.addEventListener("mouseleave", () => { if (tip) tip.hidden = true; box.querySelectorAll(".hit").forEach((h) => h.classList.remove("aan")); });
</script>

<style>
  .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  h1 { margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.025em; }
  .head p { margin: 4px 0 0; }
  .acties { display: flex; gap: 8px; }
  .seg { display: inline-flex; padding: 3px; background: var(--soft); border: 1px solid var(--line); border-radius: 10px; }
  .seg a { text-decoration: none; padding: 4px 11px; border-radius: 7px; font-weight: 500; color: var(--text-2); }
  .seg a[aria-current] { background: #fff; color: var(--text); box-shadow: 0 0 0 1px var(--line), 0 1px 2px rgba(16,24,40,.06); }

  .kpis { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1fr; }
  .kpi { padding: 22px 24px; display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .kpi + .kpi { border-left: 1px solid var(--line); }
  .lbl { font-size: 13px; font-weight: 500; color: var(--text-2); }
  .kpi b { font-size: 26px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.2; }
  .kpi b.groot { font-size: 34px; }
  .kpi > span.t3 { font-size: 13px; }
  .perbv { list-style: none; margin: 6px 0 0; padding: 8px 0 0; border-top: 1px solid var(--line); display: grid; gap: 4px; font-size: 13px; }
  .perbv li { display: flex; justify-content: space-between; gap: 12px; }
  .perbv .bvn { color: var(--text-2); }

  section.panel { margin-top: 16px; }
  .kaart { padding: 22px 24px 18px; }
  .kaartkop { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
  .kaartkop.pad { padding: 18px 20px 12px; align-items: center; }
  h2 { margin: 0; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .kaartkop p { margin: 2px 0 0; font-size: 13px; }
  .legende { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--text-2); }
  .mob { display: none; font-size: 12px; margin-top: 2px; }
  .legende i, .bvn i, .tip i, .mob i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-right: 7px; vertical-align: 1px; }
  .leeg { padding: 40px 0; text-align: center; }

  .grafiek { position: relative; margin-top: 16px; }
  .grafiek svg { width: 100%; height: auto; display: block; overflow: visible; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .grid.nul { stroke: var(--line-2); }
  .as { font-size: 12px; fill: var(--text-3); font-variant-numeric: tabular-nums; }
  .hit { fill: transparent; cursor: default; }
  .hit.aan { fill: rgba(15,17,21,.04); }
  .tip { position: absolute; top: 0; min-width: 210px; padding: 10px 12px; background: #fff; border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 8px 24px rgba(16,24,40,.12); font-size: 12px; pointer-events: none; }
  .tip :global(b) { display: block; margin-bottom: 6px; font-size: 12px; }
  .tip :global(div) { display: flex; justify-content: space-between; gap: 16px; padding: 2px 0; font-variant-numeric: tabular-nums; color: var(--text-2); }
  .tip :global(.tt) { margin-top: 4px; padding-top: 6px; border-top: 1px solid var(--line); color: var(--text); font-weight: 600; }

  .twee { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; }
  .twee > section { margin-top: 16px; min-width: 0; }
  .tabel { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-size: 12px; font-weight: 500; color: var(--text-3); padding: 8px 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fbfbfc; }
  td { padding: 12px 20px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  tbody tr:hover td { background: #fafbfc; }
  tbody tr:last-child td { border-bottom: 0; }
  tfoot td { border-top: 1px solid var(--line); border-bottom: 0; font-weight: 600; }
  .r { text-align: right; }
  .sterk { font-weight: 600; }
  .bvn { font-weight: 500; }
  td .chip { margin-left: 8px; }
  td .sub { display: block; font-size: 11px; color: var(--text-3); }
  tr.buiten td { color: var(--text-3); }
  tr.buiten td.sterk { font-weight: 500; text-decoration: line-through; text-decoration-color: var(--line-2); }

  .liq { padding: 18px 20px; }
  .liq ul { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .liqkop { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 7px; }
  .spoor { height: 6px; background: var(--soft); border-radius: 999px; overflow: hidden; }
  .spoor span { display: block; height: 100%; border-radius: 999px; }
  .liq li > .t3 { display: block; margin-top: 5px; font-size: 12px; }

  @media (max-width: 1100px) {
    .twee { grid-template-columns: 1fr; }
    .kpis { grid-template-columns: 1fr 1fr; }
    .kpis .kpi:nth-child(3) { border-left: 0; }
    .kpi:nth-child(n+3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .kpis { grid-template-columns: 1fr; }
    .kpi + .kpi { border-left: 0; border-top: 1px solid var(--line); }
    .kpi b.groot { font-size: 30px; }
    .verberg { display: none; }
    .mob { display: block; }
    .grafiek { overflow-x: auto; margin: 16px -16px 0; padding: 0 16px; }
    .grafiek svg { min-width: 640px; }
    .legende { font-size: 12px; }
    th, td { padding-left: 14px; padding-right: 14px; }
    td:first-child { white-space: normal; }
    .kaart { padding: 18px 16px 14px; }
  }
</style>
